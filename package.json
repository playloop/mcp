{
  "name": "@playloop/mcp",
  "version": "0.5.0",
  "description": "Playloop MCP server, connect Claude Desktop / Code / Cursor / Codex to your playtest data.",
  "keywords": [
    "playloop",
    "mcp",
    "model-context-protocol",
    "claude",
    "playtest",
    "game-dev"
  ],
  "license": "MIT",
  "author": "Turtlevania Games LLC",
  "homepage": "https://playloop.gg",
  "repository": {
    "type": "git",
    "url": "https://github.com/playloop/mcp"
  },
  "bugs": {
    "url": "https://github.com/playloop/mcp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "playloop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
